# Copy this file to .env and fill in real values:  cp .env.example .env
# All values here are DUMMY placeholders — never commit real secrets.

# PostgreSQL (used by the `db` service and to build DATABASE_URL)
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_pass
POSTGRES_DB=notes_db

# Used by the `api` service. Host is `db` (the compose service name), not localhost.
DATABASE_URL=postgresql://db_user:db_pass@db:5432/notes_db

# JWT signing — replace with a long random value (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`)
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# seed.py demo-user passwords
SEED_ADMIN_PASSWORD=admin-pass
SEED_ALICE_PASSWORD=alice-pass
SEED_BOB_PASSWORD=bob-pass
